{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loop state",
  "type": "object",
  "required": ["schema_version", "task", "round", "phase", "input_zip", "input_sha256", "max_rounds"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task": {"type": "string"},
    "root": {"type": "string"},
    "skill_dir": {"type": "string"},
    "max_rounds": {"type": "integer", "minimum": 1},
    "shard_count": {"type": "integer", "minimum": 1},
    "round": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["qa", "repair", "done", "stopped"]},
    "input_zip": {"type": "string"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "original_zip": {"type": "string"},
    "original_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "history": {"type": "array", "items": {"type": "object"}},
    "stop_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
